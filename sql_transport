CREATE DATABASE rio_booking;
USE rio_booking;

-- ================= CAZARI =================
CREATE TABLE cazari (
  id INT AUTO_INCREMENT PRIMARY KEY,
  nume VARCHAR(100) NOT NULL,
  pret INT NOT NULL,
  imagine VARCHAR(100)
);

-- ================= REZERVARI =================
CREATE TABLE rezervari (
  id INT AUTO_INCREMENT PRIMARY KEY,
  nume VARCHAR(100) NOT NULL,
  email VARCHAR(100) NOT NULL,
  cazare VARCHAR(100) NOT NULL,
  pret INT NOT NULL,              -- pret / noapte
  data_start DATE NOT NULL,       -- check-in
  data_end DATE NOT NULL,         -- check-out
  mesaj TEXT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

