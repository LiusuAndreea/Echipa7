CREATE DATABASE rio_booking;
USE rio_booking;

CREATE TABLE cazari (
  id INT AUTO_INCREMENT PRIMARY KEY,
  nume VARCHAR(100),
  pret INT,
  imagine VARCHAR(100)
);

CREATE TABLE rezervari (
  id INT AUTO_INCREMENT PRIMARY KEY,
  nume VARCHAR(100),
  email VARCHAR(100),
  cazare VARCHAR(100),
  persoane INT,
  data_plecare DATE,
  mesaj TEXT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
